<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The same program as Tern.Cli, packaged with the command name `sitecore`, so a team can swap
    sitecore.cli for this package in .config/dotnet-tools.json and keep every `dotnet sitecore`
    script unchanged (ADR 0003, layer 5).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>sitecore</AssemblyName>
    <RootNamespace>Tern.Cli</RootNamespace>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sitecore</ToolCommandName>
    <PackageId>Tern.Cli.Compat</PackageId>
    <Description>Tern, installed under the command name `sitecore` as a drop-in for the Sitecore CLI. Not affiliated with Sitecore.</Description>
    <ToolPackageRuntimeIdentifiers>win-x64;linux-x64;osx-x64</ToolPackageRuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Tern.Cli\**\*.cs" Exclude="..\Tern.Cli\bin\**;..\Tern.Cli\obj\**" />
    <PackageReference Include="System.CommandLine" />
    <ProjectReference Include="..\Tern.Core\Tern.Core.csproj" />
    <ProjectReference Include="..\Tern.Remote\Tern.Remote.csproj" />
    <AssemblyMetadata Include="OfficialCliLine" Value="$(OfficialCliLine)" />
  </ItemGroup>
</Project>
