<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>tern</AssemblyName>
    <RootNamespace>Tern.Cli</RootNamespace>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tern</ToolCommandName>
    <PackageId>Tern.Cli</PackageId>
    <Description>Drop-in, Native AOT replacement for the Sitecore CLI.</Description>
    <ToolPackageRuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</ToolPackageRuntimeIdentifiers>
    <!--
      Each RID package is packed on its own runner with -r <rid>, and the top-level package only
      points to them. From .NET 11 the SDK's top-level pack also packs the RIDs the current machine
      can build, which fails because restore doesn't cover them. Without -r, turning that off keeps
      the top-level pack to the top-level package, as it was on .NET 10.
    -->
    <CreateRidSpecificToolPackages Condition="'$(RuntimeIdentifier)' == ''">false</CreateRidSpecificToolPackages>
    <PackageTags>sitecore;sitecore-cli;serialization;scs;xm-cloud;sitecoreai;cli;dotnet-tool;content-sync</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <ProjectReference Include="..\Tern.Core\Tern.Core.csproj" />
    <ProjectReference Include="..\Tern.Remote\Tern.Remote.csproj" />
    <InternalsVisibleTo Include="Tern.Core.Tests" />
  </ItemGroup>
</Project>
